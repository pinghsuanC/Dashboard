// Dependency audit for CI (`npx audit-ci --config audit-ci.jsonc`).
// Fails on any high or critical advisory in production dependencies, except
// the ones listed below. Each was reviewed: the vulnerable code never runs on
// the server, or can't be reached with outside input. Remove an entry once a
// fixed version lands; `show-not-found` reports entries that no longer match.
{
  "$schema": "https://github.com/IBM/audit-ci/raw/main/docs/schema.json",
  "high": true,
  "skip-dev": true,
  "show-not-found": true,
  // Empty: the braces, deepmerge-ts and mysql2 advisories listed here before
  // were fixed upstream (Prisma 7.10.1, shadcn's newer dependencies).
  "allowlist": []
}
